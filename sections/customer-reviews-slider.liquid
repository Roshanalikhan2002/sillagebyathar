<style>


.review-section{

padding:70px 20px;
background:#ffffff;

}



.review-container{

max-width:1300px;
margin:auto;

}



.review-heading{

display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:40px;

}



.review-heading h2{

font-size:42px;
font-weight:400;
margin:0;

}



.overall-rating{

display:flex;
align-items:center;
gap:15px;
font-size:16px;

}



.big-stars,
.review-stars{

color:#D4A72C;
letter-spacing:3px;

}





.review-slider-wrapper{

position:relative;

}



.review-slider{

display:flex;
gap:25px;
overflow:hidden;
scroll-behavior:smooth;

}




.review-card{

min-width:calc(25% - 20px);
background:#fafafa;
border:1px solid #eeeeee;
border-radius:16px;
padding:30px;
display:flex;
flex-direction:column;
justify-content:space-between;

}



.review-card p{

font-size:15px;
line-height:1.7;
color:#555;
margin:20px 0;

}



.review-user{

display:flex;
flex-direction:column;
gap:6px;

}



.review-user strong{

font-size:16px;

}



.review-user span{

font-size:13px;
color:#16803c;

}




.review-arrow{

position:absolute;
top:45%;
transform:translateY(-50%);
width:45px;
height:45px;
border-radius:50%;
border:1px solid #ddd;
background:white;
font-size:30px;
cursor:pointer;
z-index:5;

}



.review-arrow.prev{

left:-20px;

}


.review-arrow.next{

right:-20px;

}




@media(max-width:900px){


.review-card{

min-width:calc(50% - 15px);

}


.review-heading{

flex-direction:column;
align-items:flex-start;
gap:20px;

}

}



@media(max-width:600px){


.review-heading h2{

font-size:30px;

}


.review-card{

min-width:90%;

}


.review-arrow.prev{

left:0;

}


.review-arrow.next{

right:0;

}


}





</style>





<script>


document.addEventListener(
"DOMContentLoaded",
function(){


const slider =
document.getElementById(
"reviewSlider"
);


const next =
document.querySelector(
".review-arrow.next"
);


const prev =
document.querySelector(
".review-arrow.prev"
);



if(next){

next.onclick=function(){

slider.scrollLeft += 350;

}

}



if(prev){

prev.onclick=function(){

slider.scrollLeft -= 350;

}

}



});



</script>




{% schema %}
{
"name": "Customer Reviews Slider",
"settings": [],
"presets": [
{
"name": "Customer Reviews Slider"
}
]
}
{% endschema %}