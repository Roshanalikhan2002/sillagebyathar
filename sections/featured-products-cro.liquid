<section class="featured-cro-section">

<div class="featured-cro-container">


<div class="featured-header">

<h2>
{{ section.settings.heading }}
</h2>


{% if section.settings.subheading != blank %}

<p>
{{ section.settings.subheading }}
</p>

{% endif %}

</div>



{% assign selected_collection = section.settings.collection %}



<div class="featured-products-slider">


{% if selected_collection != blank %}



{% for product in selected_collection.products limit: section.settings.products_limit %}


<div class="cro-product-card">



<div class="product-image-wrapper">


{% if section.settings.badge_text != blank %}

<span class="product-badge">
{{ section.settings.badge_text }}
</span>

{% endif %}



<a href="{{ product.url }}">

<img 
src="{{ product.featured_image | image_url: width: 600 }}"
alt="{{ product.title | escape }}"
class="product-main-image"
width="600"
height="600"
loading="lazy"
decoding="async"
>


</a>


</div>





<div class="product-content">



<div class="product-review">

<span>
★★★★★
</span>

<small>
4.9 (120 Reviews)
</small>

</div>





<h3>

<a href="{{ product.url }}">

{{ product.title }}

</a>

</h3>





<div class="product-price">


<span class="price">

{{ product.price | money }}

</span>



{% if product.compare_at_price > product.price %}

<span class="compare-price">

{{ product.compare_at_price | money }}

</span>


{% endif %}



</div>







<form method="post" action="/cart/add">


<input 
type="hidden"
name="id"
value="{{ product.selected_or_first_available_variant.id }}"
>




<button 
type="submit"
class="add-cart-btn">

ADD TO CART

</button>



</form>





<a href="/cart/{{ product.selected_or_first_available_variant.id }}:1"
class="buy-now-btn">

BUY NOW

</a>





</div>



</div>



{% endfor %}



{% endif %}



</div>



</div>

</section>







<style>


.featured-cro-section{

padding:70px 20px;
background:#fff;

}



.featured-cro-container{

max-width:1300px;
margin:auto;

}



.featured-header{

text-align:center;
margin-bottom:40px;

}



.featured-header h2{

font-size:38px;
font-weight:500;
margin-bottom:10px;

}



.featured-header p{

color:#666;
font-size:16px;

}





.featured-products-slider{

display:grid;
grid-template-columns:repeat(4,1fr);
gap:25px;

}





.cro-product-card{

background:#fff;
border:1px solid #eeeeee;
border-radius:16px;
overflow:hidden;
transition:.3s;

}



.cro-product-card:hover{

transform:translateY(-5px);

}






.product-image-wrapper{

position:relative;
background:#f8f6f2;
aspect-ratio:1 / 1;
contain:layout;
overflow:hidden;

}



.product-main-image{

width:100%;
height:100%;
aspect-ratio:1 / 1;
object-fit:cover;
display:block;

}





.product-badge{

position:absolute;
top:15px;
left:15px;
background:#111;
color:white;
padding:7px 14px;
font-size:12px;
border-radius:30px;
z-index:2;

}





.product-content{

padding:20px;

}





.product-review{

display:flex;
align-items:center;
gap:8px;
font-size:14px;
margin-bottom:10px;

}



.product-review span{

color:#d4af37;
letter-spacing:2px;

}



.product-review small{

color:#555;

}





.product-content h3{

margin:10px 0;
font-size:18px;

}



.product-content h3 a{

text-decoration:none;
color:#222;

}





.product-type{

font-size:13px;
color:#555;
margin-bottom:15px;

}





.product-price{

display:flex;
gap:10px;
align-items:center;
margin-bottom:20px;

}



.price{

font-size:20px;
font-weight:700;

}



.compare-price{

color:#666;
text-decoration:line-through;

}





.add-cart-btn,
.buy-now-btn{

width:100%;
height:48px;
border-radius:8px;
font-size:14px;
font-weight:600;
cursor:pointer;
display:flex;
align-items:center;
justify-content:center;
text-decoration:none;
margin-bottom:10px;

}



.add-cart-btn{

background:#111;
color:#fff;
border:none;

}



.buy-now-btn{

background:#805917;
color:#ffffff;
border:none;

}







@media(max-width:900px){


.featured-products-slider{

display:flex;
overflow-x:auto;
gap:18px;

}



.featured-products-slider::-webkit-scrollbar{

display:none;

}



.cro-product-card{

min-width:280px;

}



.featured-header h2{

font-size:30px;

}



}

</style>







{% schema %}
{
"name":"Featured Products CRO",

"settings":[


{
"type":"text",
"id":"heading",
"label":"Heading",
"default":"Our Best Selling Fragrances"
},


{
"type":"textarea",
"id":"subheading",
"label":"Sub Heading",
"default":"Discover premium scents crafted for every personality"
},


{
"type":"collection",
"id":"collection",
"label":"Select Collection"
},


{
"type":"range",
"id":"products_limit",
"label":"Products To Show",
"min":2,
"max":12,
"step":1,
"default":4
},


{
"type":"text",
"id":"badge_text",
"label":"Product Badge",
"default":"BEST SELLER"
}


],


"presets":[

{
"name":"Featured Products CRO"
}

]

}
{% endschema %}
